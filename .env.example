# Supabase project → Settings → API. Leave both empty to run device-only (no sign-in, no sync).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). Never put the secret key in a VITE_ variable:
# anything prefixed VITE_ is bundled into the browser build.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
 
# Set to true once Google is turned on in Supabase (Authentication → Providers → Google).
# Until then the "Continue with Google" button stays hidden.
VITE_GOOGLE_SIGN_IN=false
# For reminders that reach a phone with Mise closed: the public key from
# `npx web-push@3.6.7 generate-vapid-keys`. The private one is a Supabase secret,
# never a VITE_ variable. Leave empty and reminders only pop up while Mise is open.
VITE_VAPID_PUBLIC_KEY=
